# --- Storage ---------------------------------------------------------------
# Supabase (recommended for production). Run supabase/migrations/*.sql first.
# Use the secret key (sb_secret_...) or the legacy service_role key. Server-side only:
# never expose it with a NEXT_PUBLIC_ prefix.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
#
# Without these, Rankr stores everything in ./data/rankr.json (fine for local dev).
# RANKR_DATA_DIR=./data

# Accounts (one-click guest + sign-in key, no email), required to paste. Public values (Settings -> API Keys).
# Also in Supabase Auth: anonymous sign-ins on, Email provider on with "Confirm email" on (see README).
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cloudflare Turnstile site key (public), for the invisible human check on "Continue as guest" and key sign-in.
# Its secret key goes in Supabase (Authentication -> Attack Protection), not here. See README "CAPTCHA".
# Set this and deploy BEFORE turning CAPTCHA on in Supabase, or sign-ins fail in between.
# Cloudflare's test key that always passes: 1x00000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# --- Background refresh ------------------------------------------------------
# Protects /api/cron/refresh. Send it as "Authorization: Bearer <secret>" (see supabase/cron.sql).
# CRON_SECRET=some-long-random-string

# --- X account verification (optional) -----------------------------------------
# Callers verify their X account by posting a code. Without this, the post is read through X's public embed
# endpoint (no key). With an X API app's bearer token, through the X API instead.
# X_BEARER_TOKEN=...

# --- Trace tab: wallet trails and token reports (official accounts only; optional) ---
# Solana works without a key, over free public RPCs (Solana's own, then PublicNode's when one says 429). They
# allow about 40 calls of one method per 10 seconds per IP, and a server on a shared host (Vercel...) shares its
# IP with other sites, so a busy trail reads slowly or partly ("Solana's RPC is busy"). Any RPC here fixes that,
# e.g. Helius's free plan (1M credits a month, 10 requests a second): sign up at helius.dev, copy the key, then
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Several, separated by commas, are taken in turn when one is rate-limited.
# Server-side only; it never shows in logs or errors.
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...
# Calls per second to each RPC (default 9 with your own RPC, 3.5 on the public ones). Raise it for a paid plan.
# SOLANA_RPC_RPS=9
#
# Ethereum, Base, Arbitrum, Optimism and Polygon wallets need a Blockscout API key (free at dev.blockscout.com,
# 100K credits a day). Without it, those chains say tracing isn't set up.
# BLOCKSCOUT_API_KEY=...
# Point the Blockscout client somewhere else (a proxy or a test double).
# BLOCKSCOUT_API_URL=https://api.blockscout.com
#
# Token reports (a CA pasted on Trace) also read GeckoTerminal's public API and Honeypot.is, both keyless.
# Point them somewhere else (a proxy or a test double):
# GECKOTERMINAL_API_URL=https://api.geckoterminal.com/api/v2
# HONEYPOT_API_URL=https://api.honeypot.is
# An EVM token's owner() is read over PublicNode's free RPCs; any RPC of your own instead, per chain:
# ETHEREUM_RPC_URL=  BASE_RPC_URL=  ARBITRUM_RPC_URL=  OPTIMISM_RPC_URL=  POLYGON_RPC_URL=

# --- Misc ------------------------------------------------------------------
# Public URL, used for share links and social cards.
# NEXT_PUBLIC_SITE_URL=https://rankr.example.com

# Synthetic market data instead of DexScreener (offline demo). Always uses the file store.
# RANKR_MOCK=1

# Point the DexScreener client somewhere else (a proxy or a test double).
# DEXSCREENER_API_URL=https://api.dexscreener.com

# Storage. Without these Rankr writes to ./data/rankr.json (fine for local dev or a VPS).
# On serverless hosts (Vercel etc.) use Upstash Redis / Vercel KV so records persist:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# (KV_REST_API_URL / KV_REST_API_TOKEN from Vercel KV are picked up too)

# Where the file store lives (default: ./data)
# RANKR_DATA_DIR=./data

# Use synthetic market data instead of DexScreener (offline demo / UI work)
# RANKR_MOCK=1

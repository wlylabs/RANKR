# --- Storage ---------------------------------------------------------------
# Supabase (recommended for production). Run supabase/migrations/*.sql first.
# Use the secret key (sb_secret_...) or the legacy service_role key. Server-side only:
# never expose it with a NEXT_PUBLIC_ prefix.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
#
# Without these, Rankr stores everything in ./data/rankr.json (fine for local dev).
# RANKR_DATA_DIR=./data

# Accounts (one-click guest + sign-in key, no email), required to paste. Public values (Settings -> API Keys).
# Also in Supabase Auth: anonymous sign-ins on, Email provider on with "Confirm email" on (see README).
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cloudflare Turnstile site key (public), for the invisible human check on "Continue as guest" and key sign-in.
# Its secret key goes in Supabase (Authentication -> Attack Protection), not here. See README "CAPTCHA".
# Set this and deploy BEFORE turning CAPTCHA on in Supabase, or sign-ins fail in between.
# Cloudflare's test key that always passes: 1x00000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# --- Background refresh ------------------------------------------------------
# Protects /api/cron/refresh. Send it as "Authorization: Bearer <secret>" (see supabase/cron.sql).
# CRON_SECRET=some-long-random-string

# --- X account verification (optional) -----------------------------------------
# Callers verify their X account by posting a code. Without this, the post is read through X's public embed
# endpoint (no key). With an X API app's bearer token, through the X API instead.
# X_BEARER_TOKEN=...

# --- News (optional) ---------------------------------------------------------
# The News page reads every free source without a key: Google News, Bing News, GDELT, Hacker News and
# publishers' RSS (BBC, The Guardian, Al Jazeera, NPR, Sky News, Yonhap, CNA, UPI, NY Post, CoinDesk,
# Cointelegraph, Decrypt). These free APIs join in once their key is set; each is read as often as its free
# daily quota allows. All server-side.
# GNEWS_API_KEY=...        # gnews.io, 100 requests/day (free plan: non-commercial)
# NEWSDATA_API_KEY=...     # newsdata.io, 200 credits/day
# GUARDIAN_API_KEY=...     # open-platform.theguardian.com, 5,000 requests/day
# NEWSAPI_KEY=...          # newsapi.org, 100 requests/day (free plan: development only)
# CURRENTS_API_KEY=...     # currentsapi.services, ~600 requests/day
# THENEWSAPI_KEY=...       # thenewsapi.com, 3 requests/day (live list only)

# --- Misc ------------------------------------------------------------------
# Public URL, used for share links and social cards.
# NEXT_PUBLIC_SITE_URL=https://rankr.example.com

# Synthetic market data instead of DexScreener (offline demo). Always uses the file store.
# RANKR_MOCK=1

# Point the DexScreener client somewhere else (a proxy or a test double).
# DEXSCREENER_API_URL=https://api.dexscreener.com
